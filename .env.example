# Copy this file to ".env" (same folder as app.py) and fill in your own values. Never share or upload .env.

# PostgreSQL server
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waste_bin

# PostgreSQL superuser, used ONLY by setup_db.py (the password you chose when installing PostgreSQL)
PG_SUPERUSER=postgres
PG_SUPERPASS=

# Database role that owns the database (use it in pgAdmin / psql)
DB_ADMIN_USER=waste_admin
DB_ADMIN_PASSWORD=

# Database role used by the app (limited permissions)
DB_APP_USER=waste_app
DB_APP_PASSWORD=

# First login for the app's Admin tab (8+ characters)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
